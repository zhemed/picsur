{
  "name": "picsur-frontend",
  "version": "0.10.7",
  "description": "Frontend for Picsur",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/zhemed/picsur",
  "author": "zhemed",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "pnpm sync:branding && ng serve --host 0.0.0.0",
    "build": "pnpm clean && pnpm sync:branding && ng build",
    "watch": "pnpm sync:branding && ng build --watch --configuration development",
    "clean": "rm -rf dist && rm -rf .angular",
    "sync:branding": "rm -rf src/assets/branding && cp -r ../branding src/assets/branding",
    "purge": "pnpm clean && rm -rf node_modules"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource/roboto": "^5.3.0",
    "@leteu/jwt-decoder": "^1.1.2",
    "@ng-web-apis/common": "^4.11.1",
    "@ngui/common": "^1.0.0",
    "@ngx-dropzone/cdk": "^21.1.0",
    "ackee-tracker": "^5.1.3",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "fuse.js": "^7.5.0",
    "material-icons": "^1.13.14",
    "moment": "^2.31.0",
    "ngx-auto-unsubscribe-decorator": "^1.1.0",
    "ngx-moment": "^6.0.2",
    "picsur-shared": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@ng-web-apis/resize-observer": "^4.11.1",
    "@popperjs/core": "^2.11.8",
    "@types/ackee-tracker": "^5.0.4",
    "@types/node": "^22.20.5",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/validator": "^13.12.2",
    "babel-loader": "^9.2.1",
    "browserslist": "^4.24.2",
    "caniuse-lite": "^1.0.30001675",
    "typescript": "~5.9.3",
    "webpack": "^5.95.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
