{
  "private": true,
  "version": "0.10.6",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "devdb:start": "docker compose -f ./support/dev.docker-compose.yml up -d",
    "devdb:stop": "docker compose -f ./support/dev.docker-compose.yml down",
    "devdb:restart": "docker compose -f ./support/dev.docker-compose.yml restart",
    "devdb:remove": "docker compose -f ./support/dev.docker-compose.yml down --volumes --remove-orphans",
    "build": "pnpm --filter picsur-shared build && pnpm --filter picsur-backend build && pnpm --filter picsur-frontend build",
    "setversion": "./support/setversion.sh",
    "purge": "rm -rf ./node_modules",
    "purge-all": "./support/purge-all.sh",
    "format": "prettier --write .",
    "lint": "eslint  ."
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.9.3",
      "node-gyp": "^11.4.2",
      "fast-uri": "^3.1.9",
      "fastify@>=5.0.0 <5.12.6": "^5.12.6",
      "undici": "^7.30.1",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "jsonwebtoken": "^9.0.3",
      "lodash": "^4.18.1",
      "brace-expansion@>=2.0.0 <2.1.2": "^2.1.2",
      "minimatch@>=9.0.0 <9.0.6": "^9.0.7",
      "cross-spawn@>=7.0.0 <7.0.5": "^7.0.5",
      "ip-address@<=10.3.0": "^10.3.1",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "http-cache-semantics@<=4.2.0": "^4.3.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-require-extensions": "^0.1.3",
    "prettier": "^3.3.3",
    "prettier-plugin-sh": "^0.14.0",
    "typescript": "~5.5.4"
  },
  "packageManager": "pnpm@9.6.0"
}
